        "\n",
        "  # Calculate Q3 (Upper Quartile)\n",
        "  # Find the median of the upper half of the data.\n",
        "\n",
        "  if n == 1:\n",
        "      upper_quartile = sorted_temps[0]\n",
        "  else:\n",
        "      # Determine the upper half of the data\n",
        "      if n % 2 == 1: # Odd number of elements, exclude the actual median from upper half\n",
        "          upper_half_start_index = n // 2 + 1\n",
        "      else: # Even number of elements, split into two equal halves\n",
        "          upper_half_start_index = n // 2\n",
        "\n",
        "      upper_half = sorted_temps[upper_half_start_index:]\n",
        "      n_upper = len(upper_half)\n",
        "\n",
        "      if n_upper == 0:\n",
        "          upper_quartile = None # Should not happen if original list is not empty and n > 1\n",
        "      elif n_upper % 2 == 1:\n",
        "          upper_quartile = upper_half[n_upper // 2]\n",
        "      else:\n",
