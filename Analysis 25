      "source": [
        "import pandas as pd\n",
        "orders=pd.read_csv(\"orders.csv\", parse_dates=[\"order_date\"], dayfirst=True)\n",
        "promotions=pd.read_csv(\"promotions.csv\", parse_dates=[\"start_date\", \"end_date\"], dayfirst=True)\n",
        "\n",
        "result_df=pd.merge_asof (\n",
        "    orders.sort_values(\"order_date\"),\n",
        "    promotions.sort_values(\"start_date\"),\n",
        "    left_on=\"order_date\",\n",
        "    right_on=\"start_date\",\n",
        "    direction=\"backward\"\n",
        ")\n",
        "result_df.query(\"order_date<= end_date\")"
