      "source": [
        "import pandas as pd\n",
        "camp_df = pd.read_csv(\"campaign_performance.csv\")\n",
        "\n",
        "# Clean and convert 'impressions' (remove commas)\n",
        "camp_df[\"impressions\"] = camp_df[\"impressions\"].astype(str).str.replace(\",\", \"\").astype(float)\n",
        "\n",
        "# Clean and convert 'ctr' (remove % and divide by 100 to get a decimal rate)\n",
        "camp_df[\"ctr\"] = camp_df[\"ctr\"].astype(str).str.replace(\"%\", \"\").astype(float) / 100\n",
        "\n",
        "# Calculate clicks\n",
        "camp_df[\"clicks\"] = camp_df[\"ctr\"] * camp_df[\"impressions\"]\n",
        "analyse_df=camp_df.groupby('channel')[['clicks', 'impressions']].sum()\n",
        "analyse_df['ctr_perc']=(analyse_df[\"clicks\"]/analyse_df['impressions'])*100\n",
        "analyse_df"
      ]
    },
